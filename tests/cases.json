{
    "tolerances": {
        "exact": {
            "description": "the two runs must compute exactly the same numbers (bit for bit identical outputs).",
            "files": {"*": [0, 0]}
        },
        "parallel": {
            "description": "the same executable, run with other numbers of MPI processes or OpenMP threads. Only the order in which the forces are added up changes, which changes the last digits. Limit 1e-9 of the largest value of each file.",
            "files": {"*": [0, 1e-9], "angle": null}
        },
        "machine": {
            "description": "references made by another executable (macOS, Apple M3, GNU Fortran 16.2). Another compiler or machine rounds the position update x + u dt differently, so positions differ by one unit in the last digit (about 1e-16 of their largest value). The forces come from the small overlaps and stretches between floes, which these last digits change much more. Limit 1e-12 for the positions, 1e-4 for the other outputs.",
            "files": {"*": [0, 1e-4], "x": [0, 1e-12], "y": [0, 1e-12], "angle": null}
        }
    },

    "cases": {
        "TEST": {
            "description": "CHANNEL 08 initial conditions (6261 floes), bonds, wind, sheltering, diagnostics, mask",
            "namelist": "TEST.nml",
            "n": 6261,
            "runs": {
                "ref":     {"ranks": 1, "threads": 1},
                "mpi2":    {"ranks": 2, "threads": 1},
                "omp4":    {"ranks": 1, "threads": 4},
                "nodiag":  {"ranks": 1, "threads": 1,
                            "set": {"flag_diag_stress": ".false.",
                                    "flag_diag_pressure": ".false."}},
                "restart": {"ranks": 1, "threads": 1,
                            "set": {"nt": "1d1", "comp": "1d1"},
                            "restart_from": "ref", "restart_line": 2}
            },
            "checks": [
                {"type": "reference", "run": "ref", "tolerance": "machine"},
                {"type": "same", "runs": ["ref", "mpi2"], "tolerance": "parallel"},
                {"type": "same", "runs": ["ref", "omp4"], "tolerance": "parallel"},
                {"type": "same", "runs": ["ref", "nodiag"], "tolerance": "exact",
                 "files": ["x", "y", "u", "v", "theta", "omega", "r", "h",
                           "tfx", "tfy", "mom", "bond", "damage", "beam", "angle"]},
                {"type": "restart", "run": "restart", "tolerance": "exact",
                 "files": ["x", "y", "u", "v", "theta", "omega", "r", "h",
                           "bond", "damage", "beam", "angle"]},
                {"type": "mass", "run": "ref", "max_rel_change": 1e-10}
            ]
        },

        "TESTSNAP": {
            "description": "CHANNEL 08 at output line 33 (6261 floes, jammed), contacts, ridging, walls",
            "namelist": "TESTSNAP.nml",
            "n": 6261,
            "runs": {
                "ref":  {"ranks": 1, "threads": 1},
                "mpi2": {"ranks": 2, "threads": 1},
                "omp4": {"ranks": 1, "threads": 4}
            },
            "checks": [
                {"type": "reference", "run": "ref", "tolerance": "machine"},
                {"type": "same", "runs": ["ref", "mpi2"], "tolerance": "parallel"},
                {"type": "same", "runs": ["ref", "omp4"], "tolerance": "parallel"},
                {"type": "mass", "run": "ref", "max_rel_change": 1e-10}
            ]
        }
    }
}
