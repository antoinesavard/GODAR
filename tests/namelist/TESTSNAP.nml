! GODAR regression test TESTSNAP: state of the CHANNEL 08 experiment at
! output line 33 (positions, radii, thicknesses, angles), when the ice
! is jammed in the channel, so that contacts and ridging start at once.
! Same parameters as TEST, except dt: the ridged (thicker) floes make
! bonds and contacts stiffer, and dt = 5d-2 is unstable from this state.

&options_nml
    dynamics  = .true.             ! dynamical forcing
    slipping  = .true.             ! enables slipping
    thermodyn = .false.            ! growth/melt
    cohesion  = .true.             ! bond/no bond
    ridging   = .true.             ! plastic behavior at contact
    shelter   = .true.             ! sheltering from other particles
    flag_diag_stress   = .true.    ! Cauchy stress accumulation
    flag_diag_pressure = .true.    ! contact/bond pressure accumulation
    /

&numerical_param_nml
    rtree   = 4.5d3                ! search radius in kd-tree
    ntree   = 1d3                  ! time steps between tree builds
    dt      = 1d-2                 ! length of time step [s]
    nt      = 2d2                  ! number of tstep
    comp    = 2d2                  ! output steps
    /

&physical_param_nml
    Cdair    =  3d-1               ! body drag air
    Csair    =  5d-4               ! surface drag air
    Cdwater  =  3d-1               ! body drag water
    Cswater  =  2d-3               ! surface drag water
    z0w      =  3.0d-4             ! viscosity limit of water
    lat      =  1.3d0              ! latitude [rad]
    rhoair   =  1.3d0              ! air density [kg/m3]
    rhoice   =  9d02               ! ice density [kg/m3]
    rhowater =  1026d0             ! water density [kg/m3]
    /

&disk_param_nml
    e_modul         =  1d9         ! elastic moduli
    poiss_ratio     =  33d-2       ! poisson ratio nu
    friction_coeff  =  7d-1        ! friction coefficient mu
    rest_coeff      =  1d-2        ! coefficient of restitution
    sigmanc_crit    =  55d3        ! critical normal stress [Pa/m]
    /

&bond_param_nml
    eb           = 1d9
    lambda_rb    = 1d0
    lambda_lb    = 0d0
    sigmacb_crit = 55d3            ! crit. compressive strength [Pa/m]
    tau_crit     = 6.9d3           ! crit. shear strength [Pa/m]
    bond_lim     = 2d2             ! bond limit [m]
    dmax         = 0.95d0          ! max damage before breaking
    dtd          = 1d0             ! damage timescale [s]
    dth          = 1d5             ! healing timescale [s]
    phi_int      = 45d0            ! internal friction angle [deg]
    /

&forcings_nml
    uw = 0d0
    vw = 0d0
    ua = 0d0
    va = -10d0
    /

&plates_nml
    pfn = 0d0
    pfs = 0d0
    /

&input_files_nml
    Xfile = "files/xTESTSNAP.dat"
    Yfile = "files/yTESTSNAP.dat"
    Rfile = "files/rTESTSNAP.dat"
    Hfile = "files/hTESTSNAP.dat"
    Tfile = "files/thetaTESTSNAP.dat"
    Ofile = "files/omegaTESTSNAP.dat"
    mask_file = "files/maskTEST.sdf"
    /
